# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# SQLite database file (no "file:" URL scheme)
DATABASE_PATH="./data/db.sqlite"
# Extracted epub archives (one .asar per book)
ASAR_DIR="./data/asar"
# Original PDFs (one .pdf per book)
BOOKS_DIR="./data/books"
# Scratch directory used while converting an upload
TEMP_DIR="./data/temp"
# Created on first start only; ignored once an admin account exists
ADMIN_USER_NAME="admin"
ADMIN_USER_PASSWORD="123456"
# Secret used to seal session cookies. REQUIRED, at least 32 characters.
# Generate one with: openssl rand -hex 32
# The value below is an obvious placeholder — replace it before exposing the
# service, otherwise anyone who has read this repository can mint an admin
# session (iron-session encrypts the cookie with this value).
SESSION_SECRET="change-me-run-openssl-rand-hex-32-before-deploy"
# Set to true when serving over HTTPS
SESSION_COOKIE_SECURE="false"
# Upload size limit in MiB (compressed .epub bytes)
MAX_UPLOAD_SIZE_MB="200"
# PDF-specific limit in MiB (pdf.js buffers the whole file)
MAX_PDF_SIZE_MB="100"
# Cumulative size limit in MiB for the unpacked archive (zip-bomb guard)
MAX_EXTRACTED_SIZE_MB="2048"
# Largest single archive member served in one response, in MiB (over it: 413)
MAX_MEMBER_SIZE_MB="256"
# HTTP port used by server.mjs
PORT="3000"
