{
  "name": "beryllium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node server.mjs",
    "fixtures:pdf": "node tests/fixtures/build-pdf-fixtures.ts",
    "hooks:install": "node scripts/install-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "data:cleanup": "node scripts/data-cleanup.ts",
    "commit:check": "node scripts/check-commits.mjs --range origin/main..HEAD",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron/asar": "^3.2.8",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "asar-async": "^1.0.2",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "eventemitter3": "^5.0.1",
    "express": "^5.3.0",
    "iron-session": "^9.0.1",
    "jotai": "^2.20.3",
    "lodash": "^4.17.21",
    "lru-cache": "^10.1.0",
    "lucide-react": "^1.56.0",
    "mime-types": "^2.1.35",
    "mkdirp": "^3.0.1",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "5.5.207",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "rimraf": "^5.0.1",
    "sonner": "^2.0.8",
    "srvx": "^1.0.5",
    "tw-animate-css": "^1.4.0",
    "unzipper": "^0.10.14",
    "uuid": "^9.0.1",
    "xml2js": "^0.6.2",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.26",
    "@types/mime-types": "^2.1.1",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^9.0.3",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "pdfkit": "^0.20.2",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
